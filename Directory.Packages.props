<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- テスト（バージョンは基盤リポ microservices-platform と同一に保つ） -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="moomoo-api" Version="10.8.6808" />
    <!-- FR-14, IADR-0062: Discord Bot の Gateway 常駐（詳細設計07 が採用した接続方式）。Worker のアダプタにのみ隔離する。 -->
    <PackageVersion Include="Discord.Net.WebSocket" Version="3.20.1" />
    <!-- NFR, IADR-0001, #352: テスト基盤は xUnit v3（platform ADR-0030）。v3 の本体パッケージ ID は
         `xunit.v3` である（`xunit` は v2 系のまま更新されない）。3.2.x は Microsoft Testing Platform を
         取り込むが、`Microsoft.NET.Test.Sdk` ＋ `xunit.runner.visualstudio` 3.x を併用して VSTest 経路を
         維持する（CI のテストフィルタと XPlat Code Coverage 収集を従来どおり機能させるため）。 -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- ランタイム Foundation（IADR-0011 最小移植）。バージョンは基盤リポ microservices-platform と同一に保つ。 -->
    <!-- NFR, ADR-0013, IADR-0129, #354: メッセージングとローカルディスパッチは Wolverine（MIT）である。
         旧基盤の MassTransit は v9 が商用ライセンス・v8 の OSS サポートが 2026 年末で終了するため
         （platform ADR-0027）、#354 の 3 段階で全面移行し、第 3 段階で CPM 宣言ごと削除した。
         再混入は scripts/check-banned-libraries.js が BANNED として止める。
         WolverineFx.RuntimeCompilation は必須である: Wolverine 6 系はコア本体からランタイムコンパイラ
         （Roslyn）を分離しており、既定の TypeLoadMode.Dynamic のままでは起動時に例外で停止する
         （実測。代替は codegen 事前生成＋TypeLoadMode.Static。IADR-0129 決定 6）。 -->
    <PackageVersion Include="WolverineFx" Version="6.24.5" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.24.5" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.24.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <!-- ロギング抽象（ライブラリでの ILogger 用。net10 の共有フレームワーク・Mvc.Testing 推移依存と揃える）。 -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <!-- Worker ホスト / 永続化（#12 Slice B・IADR-0012）。バージョンは基盤リポと同一に保つ。 -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <!-- 実コンテナ統合 E2E（issue #82 / IADR-0049）。Testcontainers で実 PostgreSQL/RabbitMQ を起動する。
         Category=Integration のテストのみが参照し、既定 CI では実行しない（nightly/dispatch で実走）。 -->
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.13.0" />
    <!-- Slice B（#82 / IADR-0050）: OwnerOnly エンドポイントを実 Keycloak トークンで検証する。 -->
    <PackageVersion Include="Testcontainers.Keycloak" Version="4.13.0" />
    <!-- NFR, #61 と同手順: Testcontainers が推移的に持ち込む SSH.NET のセキュリティ更新。
         2025.1.0 に高深刻度の脆弱性が公表され（GHSA-q939-rpr3-3284）、`security` ワークフローの
         「Vulnerable transitive dependencies」が develop・全 PR で一斉に落ちた（本リポの差分に起因しない）。
         **推移パッケージであるため直接参照は増やさず**、CPM の推移ピン留め
         （`CentralPackageTransitivePinningEnabled`）でパッチ版へ引き上げる。
         引き上げ後に `dotnet list package` の脆弱性検査（vulnerable ＋ 推移を含める指定）が
         「no vulnerable packages」を返すことを実測で確認している。 -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- NFR, ADR-0013, IADR-0129, #354（第 3 段階）: 実 RabbitMQ 上のトポロジ（キュー・consumer 数・DLQ）を
         受動宣言で読むために Integration E2E だけが直接参照する。WolverineFx.RabbitMQ が推移的に持ち込む版と
         同一に固定する（CPM の推移ピン留めが効いており、版がずれると同居できない）。 -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.1.2" />
  </ItemGroup>
</Project>
