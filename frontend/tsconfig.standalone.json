{
  // IADR-0080 決定 2: 単独リポ（platform 非合成）向けの型検査。@foundation をテスト/型検査専用スタブへ解決し、
  // platform 非依存で tsc が通るようにする。platform へ合成された時は tsconfig.json（実 foundation への paths）が使われる。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@foundation/*": ["./test/foundation-stub/*"],
      // 共有 UI（@platform/ui）は基盤の pnpm workspace パッケージであり単独リポでは解決できない。
      // 役割・テキストを実物と一致させた薄いスタブへ解決する（vitest.config.ts の alias と同じ向き先）。
      "@platform/ui": ["./test/ui-stub/index.ts"],
      "@ai-stock-trading/*": ["src/*"]
    }
  },
  "include": ["src", "test"]
}
