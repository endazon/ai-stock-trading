{
  "name": "@ai-stock-trading/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 株取引ユニットの画面 features（sc01-settings ほか）。platform SPA の合成点（src/features/index.ts）が型付きルート factory ＋ ナビ項目を束ねる可変機能ユニット。単独リポでは @foundation をテスト/型検査用スタブへ解決して自己完結する（IADR-0080 / IADR-0286）。",
  "scripts": {
    "typecheck": "tsc -p tsconfig.standalone.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit",
    "e2e:serve": "vite --config e2e/vite.harness.config.ts",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.11.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
