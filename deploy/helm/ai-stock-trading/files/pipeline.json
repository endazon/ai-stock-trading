{
  "version": 1,
  "events": [
    "PriceMovementDetected",
    "InformationCollected",
    "StopLossTriggered",
    "TradeDecisionMade",
    "OrderApproved",
    "OrderRejected",
    "OrderExecuted"
  ],
  "sources": [
    { "event": "PriceMovementDetected", "service": "market-monitor-service" },
    { "event": "StopLossTriggered", "service": "market-monitor-service" },
    { "event": "InformationCollected", "service": "information-collection-service" }
  ],
  "steps": [
    {
      "name": "decide-on-price-movement",
      "service": "trade-decision-service",
      "consumer": "TradeDecisionService.Infrastructure.Steps.PriceMovementDetectedHandler",
      "input": "PriceMovementDetected",
      "outputs": ["TradeDecisionMade"],
      "enabled": true
    },
    {
      "name": "decide-on-information",
      "service": "trade-decision-service",
      "consumer": "TradeDecisionService.Infrastructure.Steps.InformationCollectedHandler",
      "input": "InformationCollected",
      "outputs": ["TradeDecisionMade"],
      "enabled": true
    },
    {
      "name": "risk-approve",
      "service": "risk-management-service",
      "consumer": "RiskManagementService.Infrastructure.Steps.TradeDecisionMadeHandler",
      "input": "TradeDecisionMade",
      "outputs": ["OrderApproved", "OrderRejected"],
      "enabled": true
    },
    {
      "name": "risk-stop-loss",
      "service": "risk-management-service",
      "consumer": "RiskManagementService.Infrastructure.Steps.StopLossTriggeredHandler",
      "input": "StopLossTriggered",
      "outputs": ["OrderApproved"],
      "enabled": true
    },
    {
      "name": "execute-order",
      "service": "order-execution-service",
      "consumer": "OrderExecutionService.Infrastructure.Steps.OrderApprovedHandler",
      "input": "OrderApproved",
      "outputs": ["OrderExecuted"],
      "enabled": true
    }
  ]
}
