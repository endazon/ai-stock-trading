{
  "realm": "ai-stock-trading",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "trading-owner",
        "description": "dev: OwnerOnly (ADR-0007 / IADR-0011). The sole role allowed to operate kill switch / risk settings / stage promotion."
      },
      {
        "name": "trading-service",
        "description": "dev: OwnerOrService read-only (IADR-0051). Service-to-service role for sync queries (sizing-context / open-positions / daily-policy). Cannot operate kill switch / settings."
      }
    ]
  },
  "users": [
    {
      "username": "dev-owner",
      "enabled": true,
      "emailVerified": true,
      "email": "dev-owner@example.com",
      "firstName": "Dev",
      "lastName": "Owner",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "owner", "temporary": false }
      ],
      "realmRoles": ["trading-owner"]
    },
    {
      "username": "developer",
      "enabled": true,
      "emailVerified": true,
      "email": "developer@example.com",
      "firstName": "Dev",
      "lastName": "Developer",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "developer", "temporary": false }
      ],
      "realmRoles": ["trading-owner"]
    },
    {
      "username": "service-account-ai-stock-trading-svc",
      "enabled": true,
      "serviceAccountClientId": "ai-stock-trading-svc",
      "realmRoles": ["trading-service"]
    }
  ],
  "clients": [
    {
      "clientId": "ai-stock-trading-dev",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"]
    },
    {
      "clientId": "ai-stock-trading-svc",
      "description": "dev: confidential service client for s2s sync queries (IADR-0051). client_credentials only. Production secret comes from config (user-secrets / .env), not this dev export.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-only-service-secret",
      "redirectUris": [],
      "webOrigins": []
    }
  ]
}
