<!-- 計画確定値（05_trading-assumptions §1/§4/§5/§6 / ADR-0008 / ADR-0016 / ADR-0018）と実装の適合検査（#343・IADR-0127）。
     全面再実装（#344）中は既知逸脱レジストリで受容し、担当 issue が解消したら登録簿の更新を強制する。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>AiStockTrading.PlanConformance.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector" />
    <ProjectReference Include="..\..\Services\RiskManagementService\src\RiskManagementService.Domain\RiskManagementService.Domain.csproj" />
    <!-- Stage 0 合格基準の DD 許容値（ADR-0018 決定2）は Stage0GateCriteria が保持する。 -->
    <ProjectReference Include="..\..\Services\BacktestService\src\BacktestService.Domain\BacktestService.Domain.csproj" />
    <!-- 全体前提条件の確定値（§1 譲渡益税率 / §4 最小期待利益 / §6 月次費用上限）は
         TradingAssumptionsDefaults と CostCalculator が保持する。 -->
    <ProjectReference Include="..\..\Services\ConfigurationService\src\ConfigurationService.Domain\ConfigurationService.Domain.csproj" />
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Contracts\AiStockTrading.Shared.Contracts.csproj" />
    <!-- ADR-0022, IADR-0135: 為替レート源（Fx:Provider）と鮮度しきい値は FxOptions / FxRateSourceFactory が
         保持する。実装型は internal のまま（IADR-0128）であるため、参照は**リフレクション経由**であり
         InternalsVisibleTo は増やさない。抽出経路が無いと計画側に転記した Fx 3 キーが検査2（抽出漏れ）で
         恒久的に赤になり、既知逸脱としても受容できない（検査2 は登録簿を参照しない）。 -->
    <ProjectReference Include="..\..\Services\TradeDecisionService\src\TradeDecisionService.Infrastructure\TradeDecisionService.Infrastructure.csproj" />
  </ItemGroup>
</Project>
