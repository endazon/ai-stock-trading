<!-- NFR/IADR-0259 決定4: サービス単位のテストは 1 プロジェクトへ統合する（旧 Api/Application/Domain/Infrastructure
     の 4 本を統合。中身は移送のみで変えていない。旧 Application.Tests/TestDoubles.cs と旧 Infrastructure.Tests/
     TestDoubles.cs の重複型定義は 1 ファイルへ統合した。詳細は Tests/TestDoubles.cs 冒頭コメント）。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <ProjectReference Include="..\MarketMonitorService.csproj" />
    <!-- ADR-0013, IADR-0129, #354: Wolverine のハンドラをランタイム生成で動かすため（RuntimeCompilation）、
         共通配線ヘルパを持つ shim をテストからのみ参照する。 -->
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.Messaging\AiStockTrading.TestSupport.Messaging.csproj" />
    <!-- #389 / #340, IADR-0146: バックエンド応答↔フロント契約フィクスチャの突合（テスト専用の共有支援）。 -->
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.ContractFixtures\AiStockTrading.TestSupport.ContractFixtures.csproj" />
    <!-- #957, IADR-0399: 保有照会の「評価できなかった行」の計器（ast.market_monitor.position_rows_degraded）の発火を表明する。 -->
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.Metrics\AiStockTrading.TestSupport.Metrics.csproj" />
    <!-- FR-03, FR-10, #943, IADR-0390: 損切り検知が読む GET /risk-controls/open-positions の契約テスト（T-10-803）が
         送り手の本物の型（OpenPositionView）を直列化するためのテスト専用参照。本体（MarketMonitorService.csproj）は参照しない。
         移送先は Web SDK で `public partial class Program` を持つため、`Program` の曖昧（CS0433）を避けて extern alias で参照する
         （TradeDecisionService.Tests・AiStockTrading.IntegrationTests と同じ別名）。 -->
    <ProjectReference Include="..\..\RiskManagementService\RiskManagementService.csproj" Aliases="RiskManagementWorker" />
  </ItemGroup>
</Project>
