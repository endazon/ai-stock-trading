<!-- #9 Slice A, FR-01, IADR-0022: 情報収集 Worker ホスト。定時ポーリングで収集→正規化→サニタイズ→KB 保存→収集完了イベント発行。
     ヘルスチェックのため Web SDK を使用。DB・認可なし。外部情報源・KB 保存は安全既定（no-op）でゲート。実行時基盤は test-support shim（IADR-0013）。 -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>AiStockTrading.InformationCollection.Worker</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <ProjectReference Include="..\InformationCollectionService.Application\InformationCollectionService.Application.csproj" />
    <!-- 収集完了イベント（InformationCollected）の発行に共有契約を参照する。 -->
    <ProjectReference Include="..\..\..\..\Shared\AiStockTrading.Shared.Contracts\AiStockTrading.Shared.Contracts.csproj" />
    <!-- IADR-0068: Finnhub 呼び出し（FinnhubQuoteClient）とレート制限（TokenBucket 系）を共有物へ抽出したため参照する。 -->
    <ProjectReference Include="..\..\..\..\Shared\AiStockTrading.Shared.Infrastructure\AiStockTrading.Shared.Infrastructure.csproj" />
    <!-- IADR-0013: ランタイム基盤は platform 由来の最小移植 shim（本番非使用の足場）を参照する。 -->
    <ProjectReference Include="..\..\..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
    <InternalsVisibleTo Include="InformationCollectionService.Worker.Tests" />
  </ItemGroup>
</Project>
