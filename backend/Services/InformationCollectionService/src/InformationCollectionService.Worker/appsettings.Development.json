{
  // 開発（ローカル/compose）用の設定点。実行時は compose の環境変数（`__` 区切り）が最優先で上書きする。
  // env=Testing のテストは本ファイルを読み込まないため、既定挙動（安全既定）に干渉しない（IADR-0048 決定 1）。
  "Serilog": { "MinimumLevel": { "Default": "Debug" } },
  "RabbitMq": { "ConnectionString": "amqp://guest:guest@rabbitmq:5672" },
  "Otlp": { "Endpoint": "http://otel-collector:4317" },
  // FR-01, IADR-0022/0064: 情報源セレクタ。Provider 空=NoOp（外部接続しない）。案A+（ADR-0004）はカンマ区切りで
  // 複数指定する（例: "finnhub,sec-edgar,edinet,boj,fred"）。列挙しても当該ソースの必須設定が空なら、そのソースだけ
  // 無効に倒れる（他ソースは有効なまま）。SecEdgar:UserAgent は SEC 規約で必須の連絡先。
  "Collection": {
    "PollIntervalSeconds": 300,
    "Source": {
      "Provider": "",
      "Finnhub": { "ApiKey": "", "Symbols": [] },
      "SecEdgar": { "UserAgent": "", "Ciks": [] },
      "Edinet": { "SubscriptionKey": "" },
      "Boj": { "Db": "", "SeriesCodes": [] },
      "Fred": { "ApiKey": "", "SeriesIds": [] }
    }
  },
  // NFR(費用), IADR-0031: 費用統制の照会 URL。空=プレースホルダ（Normal=間隔延長/停止しない）。
  // 設定すると GET /costs/state を s2s で同期照会し、Throttled=間隔延長・Halted=巡回停止を適用する（#79）。
  "CostControl": { "BaseUrl": "" },
  // FR-08, IADR-0069: 実 KB 連携の opt-in URL。Documents:BaseUrl 空=保存 no-op（LoggingKnowledgeBaseSink）。
  // 設定すると収集情報を platform DocumentService（POST /documents）へ s2s で保存する（KnowledgeBaseWriterSink）。
  // 注意: 書き込みは platform-admin/operator ロールを要するため、ロール未付与なら 403→未保存に fail-safe 縮退する（後続 #9）。
  // Search:BaseUrl は RAG 取得（RetrievalService）の opt-in。本サービスは未使用（#11 で TradeDecision が利用）。
  "KnowledgeBase": { "Documents": { "BaseUrl": "" }, "Search": { "BaseUrl": "" } },
  // IADR-0051: OwnerOrService エンドポイント（/costs/state）への s2s トークン導出元。ClientSecret は user-secrets / .env（ServiceAuth__ClientSecret）へ。
  "Auth": { "Authority": "http://keycloak:8080/realms/ai-stock-trading" },
  // IADR-0051: s2s サービストークン（client_credentials）。ClientId/ClientSecret 空=無効（認証なし→401→Normal の安全既定）。
  "ServiceAuth": { "ClientId": "", "ClientSecret": "" }
}
