<!-- #9 Slice A, FR-01, IADR-0022, IADR-0128: 情報収集サービスの技術詳細（公式情報源アダプタ・KB シンク・
     費用統制ゲート・定時ポーリング＝収集→正規化→サニタイズ→KB 保存→収集完了イベント発行）。
     ホスト（Program.cs・DI 構成）は Api に置く。共有フレームワーク型（BackgroundService/IOptions/ILogger 等）を
     使うため FrameworkReference を持つ（TestSupport.PlatformShim と同型）。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>AiStockTrading.InformationCollection.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <ProjectReference Include="..\InformationCollectionService.Application\InformationCollectionService.Application.csproj" />
    <!-- 収集完了イベント（InformationCollected）の発行に共有契約を参照する。 -->
    <ProjectReference Include="..\..\..\..\Shared\AiStockTrading.Shared.Contracts\AiStockTrading.Shared.Contracts.csproj" />
    <!-- IADR-0068: Finnhub 呼び出し（FinnhubQuoteClient）とレート制限（TokenBucket 系）を共有物へ抽出したため参照する。 -->
    <ProjectReference Include="..\..\..\..\Shared\AiStockTrading.Shared.Infrastructure\AiStockTrading.Shared.Infrastructure.csproj" />
    <!-- FR-08, IADR-0069: 実 KB 保存（IKnowledgeBaseWriter）へ委譲する KnowledgeBaseWriterSink のため共有 KB クライアントを参照する。 -->
    <ProjectReference Include="..\..\..\..\Shared\AiStockTrading.Shared.KnowledgeBase\AiStockTrading.Shared.KnowledgeBase.csproj" />
    <!-- IADR-0128: 実装型は internal のまま据え置き、composition root（Api）とその
         テストにだけ可視にする。public へ広げると分割前に無かった公開面が生まれる。 -->
    <InternalsVisibleTo Include="InformationCollectionService.Api" />
    <InternalsVisibleTo Include="InformationCollectionService.Api.Tests" />
    <InternalsVisibleTo Include="InformationCollectionService.Infrastructure.Tests" />
  </ItemGroup>
</Project>
