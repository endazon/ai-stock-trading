<!-- NFR/IADR-0259 決定4: サービス単位のテストは 1 プロジェクトへ統合する（旧 Api/Application/Domain/Infrastructure
     の 4 本を統合。中身は移送のみで変えていない）。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <ProjectReference Include="..\TradeDecisionService.csproj" />
    <!-- NFR, #947, IADR-0397: 本番の組み立て（Program.cs）を組んで配線の抜けを検査する共有ガード。 -->
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.Composition\AiStockTrading.TestSupport.Composition.csproj" />
    <!-- NFR/IADR-0259 決定1: リスク管理サービスの単一プロジェクト移送（W11 段 4-11）で、推移参照として入る
         RiskManagementService（Web SDK・`public partial class Program` を持つ）が `Program` を曖昧にする（CS0433）。
         推移参照には Aliases が伝播しないため、ここで同じプロジェクトを明示参照して extern alias を与える
         （IADR-0050 決定1 と同じ機構。別名は本リポジトリ共通の RiskManagementWorker）。 -->
    <ProjectReference Include="..\..\RiskManagementService\RiskManagementService.csproj" Aliases="RiskManagementWorker" />
    <!-- FR-04, FR-07, #957, IADR-0408（2026-09-25 追記）: 報告書の日報方針（GET /reports/daily-policy）の契約テスト（T-10-910）が
         送り手の本物の型（ConfirmedDailyPolicy）を直列化するためのテスト専用参照。`Program` の曖昧を避けて extern alias で参照する
         （AiStockTrading.IntegrationTests と同じ別名）。 -->
    <ProjectReference Include="..\..\ReportService\ReportService.csproj" Aliases="ReportWorker" />
    <!-- FR-02, FR-13, #957, IADR-0408（2026-09-25 追記）: 市場監視の監視銘柄（GET /monitor/watchlist）の契約テスト（T-10-930）が
         送り手の本物の型（MonitoredSymbol）を直列化するためのテスト専用参照。`Program` の曖昧を避けて extern alias で参照する
         （別名は RiskManagementWorker と同じ命名規則）。 -->
    <ProjectReference Include="..\..\MarketMonitorService\MarketMonitorService.csproj" Aliases="MarketMonitorWorker" />
    <!-- FR-04, #1118, IADR-0420, IADR-0467 決定 2: 発注執行の日足（GET /order-execution/daily-bars）の契約テスト（T-10-1836）が
         送り手の本物の型（DailyBarsView）を直列化するためのテスト専用参照。`Program` の曖昧を避けて extern alias で参照する
         （リスク管理のテストと同じ別名 OrderExecutionWorker）。 -->
    <ProjectReference Include="..\..\OrderExecutionService\OrderExecutionService.csproj" Aliases="OrderExecutionWorker" />
    <!-- NFR, FR-11, #1111, IADR-0483 決定1・4: 取引判断の最中の例外の最終の失敗（T-10-2186）が、`Exception.Data` と内側の例外に
         秘密を持つ例外でも、監査台帳の記録（AuditEntryFactory の要約と Detail）へ秘密を運ばないことを、発行の実装から台帳の
         記録まで続けて確かめるためのテスト専用参照。`Program` の曖昧を避けて extern alias で参照する
         （ReportService.Tests と同じ別名 AuditWorker）。 -->
    <ProjectReference Include="..\..\AuditService\AuditService.csproj" Aliases="AuditWorker" />
    <!-- ADR-0013, IADR-0129, #354: 本番と同じ Wolverine 配線（UseAiStockTradingRabbitMq）でホストを起こして検証するため、
         共通配線ヘルパを持つ shim をテストからのみ参照する（ハンドラのランタイム生成 RuntimeCompilation も同経路で入る）。 -->
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.Messaging\AiStockTrading.TestSupport.Messaging.csproj" />
    <!-- NFR-07, #287, IADR-0255: 業務メトリクスが実際に発火することを MeterListener で観測する共有支援。 -->
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.Metrics\AiStockTrading.TestSupport.Metrics.csproj" />
  </ItemGroup>
</Project>
