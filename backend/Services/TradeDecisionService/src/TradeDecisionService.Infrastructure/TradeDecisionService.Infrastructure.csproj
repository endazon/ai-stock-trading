<!-- #11 Slice A, IADR-0013/0017, IADR-0128: 取引判断サービスの技術詳細（LLM/為替/監視銘柄/日報/建玉の各アダプタ・
     PriceMovementDetected / InformationCollected の consumer）。ホスト（Program.cs・DI 構成）は Api に置く。
     共有フレームワーク型（IOptions/ILogger/Hosting 等）を使うため FrameworkReference を持つ
     （TestSupport.PlatformShim と同型）。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>TradeDecisionService.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- ADR-0013, IADR-0129, #354: メッセージングは Wolverine（ハンドラ規約・IMessageBus）。 -->
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <ProjectReference Include="..\TradeDecisionService.Application\TradeDecisionService.Application.csproj" />
    <!-- FR-08, IADR-0069/0072: RAG 取得ポート IKnowledgeBaseSearch（#18 共有クライアント）を判断文脈へ結線するため参照する。 -->
    <ProjectReference Include="..\..\..\..\Shared\AiStockTrading.Shared.KnowledgeBase\AiStockTrading.Shared.KnowledgeBase.csproj" />
    <!-- FR-02, IADR-0068/0099: 判断文脈の現在値供給に共有の現在値ソース（MarketDataSourceFactory・IMarketDataSource）を用いるため参照する。 -->
    <ProjectReference Include="..\..\..\..\Shared\AiStockTrading.Shared.Infrastructure\AiStockTrading.Shared.Infrastructure.csproj" />
    <!-- FR-17, NFR, #526, IADR-0264 決定 1: 前提条件の解決（ExternalServices/）は s2s トークン付与
         （AddAiStockTradingServiceToken）を使うため shim を参照する。旧 ConfigurationService.Client が
         持っていた参照を、複製先である本プロジェクトが引き継いだもの。 -->
    <ProjectReference Include="..\..\..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
    <!-- IADR-0128: 実装型は internal のまま据え置き、composition root（Api）とその
         テストにだけ可視にする。public へ広げると分割前に無かった公開面が生まれる。 -->
    <InternalsVisibleTo Include="TradeDecisionService.Api" />
    <InternalsVisibleTo Include="TradeDecisionService.Api.Tests" />
    <InternalsVisibleTo Include="TradeDecisionService.Infrastructure.Tests" />
  </ItemGroup>
</Project>
