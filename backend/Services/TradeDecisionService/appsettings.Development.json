{
  // 開発（ローカル/compose）用の設定点。実行時は compose の環境変数（`__` 区切り）が最優先で上書きする。
  // env=Testing のテストは本ファイルを読み込まないため、既定挙動（安全既定）に干渉しない（IADR-0048 決定 1）。
  "Serilog": { "MinimumLevel": { "Default": "Debug" } },
  "RabbitMq": { "ConnectionString": "amqp://guest:guest@rabbitmq:5672" },
  "Otlp": { "Endpoint": "http://otel-collector:4317" },
  // FR-07/04/10, IADR-0028/0029: 日報方針・サイジング文脈の同期照会 URL。空=プレースホルダ（取引しない=安全既定）。#76 後続で有効化。
  "Reports": { "BaseUrl": "" },
  "RiskManagement": { "BaseUrl": "" },
  // FR-02/13, UC-06, SC-02, IADR-0088/0095: 監視銘柄（watchlist）の権威源＝市場監視（#10 MarketMonitor）の GET /monitor/watchlist を
  // s2s 同期照会する URL。空/不正=構成ベース（TradeCycle:Watchlist）＝現行挙動（後方互換）。設定すると SC-02 変更が定時サイクルに反映される。
  "MarketMonitor": { "BaseUrl": "" },
  // FR-02, #158, IADR-0068/0099: 判断文脈の現在値（価格文脈）供給。Provider=none（既定）は実接続せず現在値なし＝現行挙動
  //（定時サイクルは価格文脈が無く LLM が Hold）。Provider=finnhub＋Finnhub:ApiKey（環境変数 MARKETDATA_FINNHUB_API_KEY）で
  // 実市況を opt-in すると、定時サイクルにも現在値が供給され、権威価格でサイジング・損切りされる。取得不可/鮮度切れ
  //（MaxQuoteStalenessSeconds 超過）は安全側（Hold・発注抑止）。実弾 triple-latch（IADR-0060）には影響しない。
  // RequestsPerMinute は当サービスへ配るレート予算（全プロセス合計を Finnhub 無料枠 60/分以内に保つ・IADR-0068 決定4）。
  // IADR-0274 実測（60回/60秒固定ウィンドウ）を踏まえ、同一鍵を情報収集と共有する運用でも合計が実測上限を
  // 超えないよう既定 10→5 に是正（情報収集30 + 市況5×4サービス=50/分。同一鍵を共有しないなら引き上げてよい）。
  "MarketData": {
    "MaxQuoteStalenessSeconds": 300,
    "Provider": "none",
    "Finnhub": { "ApiKey": "", "RequestsPerMinute": 5 }
  },
  // FR-10/17, #257, #364, IADR-0107/0152: 基準通貨（**USD**）への換算レート源。統制上限・サイジングは
  // 基準通貨建てで判定するため、非基準通貨（**日本株**）の銘柄はレートが解決できないと新規建てを見送る
  // （過大発注を招かない安全側）。**米国株は基準通貨のため定義上レート 1** で従来どおり判断できる。
  //   ※ 上記 3 行は IADR-0152 の基準通貨反転（円 → USD）を反映して 2026-08-15 に訂正した。
  //     訂正前は「基準通貨（円）／日本株は定義上レート 1」と書かれており、実装と逆であった（#381）。
  // Provider=none（既定）は実接続しない。
  // #381, ADR-0022 決定1・2, IADR-0194: Provider=boj が**推奨**である（日銀「外国為替市況（日次）」を第一とし、
  //   FRED をフォールバックとする）。**日銀は認証不要**のため boj だけで動く。Fred:ApiKey も設定すると
  //   順位つきフォールバック（日銀 → FRED）になる。フォールバックが無い場合は起動時に警告が出る。
  //   Provider=fred は FRED 単独。**DEXJPUS は系列こそ営業日次だが公表は H.10 週次**であり、最新観測の齢は
  //   最大 12.84 日まで積み上がる ＝ **5 日の警告しきい値に対して警告域へ常駐する**（常時鳴る警告になる）。
  // CacheTtlSeconds=取得済みレートの再利用時間（既定 6 時間）。
  // #381, ADR-0022 決定4・5, IADR-0174: 鮮度の縮退は 3 段である。5 日以下＝通常／5 日超〜30 日以下＝直近レートで
  // 続行し警告（新規建ては止めない）／30 日超＝新規建てを停止（手仕舞い・損切りは止めない）。
  //   ⚠️ **手仕舞いについては現状が計画と乖離している（#506）。** 非基準通貨ではレート未解決時に
  //     判断由来の決済も止まる。米国株は影響を受けない。
  // StaleRateWarningDays=警告のしきい値（既定 5 日）。MaxRateAgeDays=停止の上限（既定 30 日＝計画の絶対上限）。
  // 0 以下は既定へ、30 日超は 30 日へ丸める（設定で鮮度 guard を実質無効化できない）。警告も上限でクランプする
  // （警告が上限を超えると、警告が一度も出ないまま停止する＝気づく機会が消える）。
  "Fx": {
    "Provider": "none",
    "CacheTtlSeconds": 21600,
    "MaxRateAgeDays": 30,
    "StaleRateWarningDays": 5,
    "Boj": { "SeriesCode": "FXERD04", "Db": "fm08", "RequestsPerMinute": 1 },
    "Fred": { "ApiKey": "", "SeriesId": "DEXJPUS", "RequestsPerMinute": 5 }
  },
  // FR-04/11, ADR-0010, IADR-0061: 実 LLM は platform LLM ゲートウェイ（POST /complete）へ委譲する。
  // BaseUrl 空=Placeholder（実 LLM を呼ばない=常に Hold）。TimeoutSeconds 空/不正/非正値=既定 30 秒。
  // LogPrompts=プロンプト・生出力の全量ログ（FR-11）。既定 false=残さない（機微を既定でログ基盤へ流さない）。
  "LlmGateway": { "BaseUrl": "", "TimeoutSeconds": "", "LogPrompts": false },
  // FR-08, IADR-0069/0072: RAG 取得（収集情報・判断根拠を KB から引いて本判断プロンプトへ注入）。
  // Search:BaseUrl 空=NoOp 検索（空取得＝参考情報なし＝現行動作）。設定すると platform RetrievalService（POST /search）へ s2s 照会する。
  // Auth（IADR-0093）: KB の s2s は MSP レルムの専用クライアント（ai-stock-trading-kb-writer／platform-operator）で認証する
  //   （AST レルムの ServiceAuth では 401/403）。Authority は MSP レルム。空=トークン無し（現行の NoOp 検索を保持）。
  "KnowledgeBase": { "Search": { "BaseUrl": "" }, "Auth": { "Authority": "", "ClientId": "", "ClientSecret": "" } },
  // 取得件数（TopK）。空・不正・非正値=既定 5（IADR-0072 決定5）。
  "Retrieval": { "TopK": "" },
  // FR-17, IADR-0021/0063/0076: 全体前提条件（手数料・為替スプレッド・最小期待利益倍率）の同期照会 URL。
  // 空=DefaultAssumptionsProvider（未解決＝採算見積り不能）。採算評価ゲートを実効化するには本 URL と Profitability:Enabled を対で設定する。
  "Configuration": { "BaseUrl": "" },
  // FR-17, 05_trading-assumptions §4, IADR-0076: 採算評価ゲート（最小期待利益）。
  // Enabled 既定 false=現行挙動（採算評価しない）。true で採算不成立・費用見積り不能を Hold に倒す。
  // DecisionCostJpy=この取引の判断費用の固定見積り（円）。空・不正・非正値=0（中立）。LLM 月次計測（IADR-0055）とは別目的の per-trade 見積り。
  "Profitability": { "Enabled": false, "DecisionCostJpy": "" },
  // IADR-0051: OwnerOrService エンドポイントへの s2s トークン導出元。ClientSecret は user-secrets / .env（ServiceAuth__ClientSecret）へ。
  "Auth": { "Authority": "http://keycloak:8080/realms/ai-stock-trading" },
  // IADR-0051: s2s サービストークン（client_credentials）。ClientId/ClientSecret 空=無効（認証なし→401→安全既定）。#76。
  "ServiceAuth": { "ClientId": "", "ClientSecret": "" }
}
