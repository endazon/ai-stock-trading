<!-- #15 Slice A, FR-09, IADR-0020, IADR-0128: 通知サービスの API ホスト。イベント購読と Discord アウトバウンド通知の
     DI 構成、ヘルスチェックのため Web SDK を使用。DB・認可なし（送信は fire-and-forget）。実 Discord 送信は既定で無効
     （安全既定）。実行時基盤は test-support shim（本番非使用・IADR-0013）。技術詳細（Discord アダプタ・consumer）は
     Infrastructure に置く。 -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>NotificationService.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- ADR-0013, IADR-0129, #354: メッセージングは Wolverine（RabbitMQ）。共通配線は shim の WolverineExtensions。 -->
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <ProjectReference Include="..\NotificationService.Application\NotificationService.Application.csproj" />
    <!-- IADR-0128 決定 1: 具象実装（通知送信アダプタ・Gateway 常駐・consumer）の DI 登録は composition root（Api）が行う。 -->
    <ProjectReference Include="..\NotificationService.Infrastructure\NotificationService.Infrastructure.csproj" />
    <!-- IADR-0013: ランタイム基盤は platform 由来の最小移植 shim（本番非使用の足場）を参照する。 -->
    <ProjectReference Include="..\..\..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
    <InternalsVisibleTo Include="NotificationService.Api.Tests" />
  </ItemGroup>
</Project>
