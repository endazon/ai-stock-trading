<!-- #15 Slice A, FR-09, IADR-0020: 通知 Worker ホスト。イベント購読→Discord アウトバウンド通知。
     ヘルスチェックのため Web SDK を使用。DB・認可なし（送信は fire-and-forget）。実 Discord 送信は既定で無効（安全既定）。
     実行時基盤は test-support shim（本番非使用・IADR-0013）。 -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>AiStockTrading.Notification.Worker</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MassTransit.RabbitMQ" />
    <!-- FR-14, IADR-0063 決定1: Gateway 常駐（詳細設計07 の採用方式）。Application へは漏らさずアダプタに隔離する。 -->
    <PackageReference Include="Discord.Net.WebSocket" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <ProjectReference Include="..\NotificationService.Application\NotificationService.Application.csproj" />
    <!-- IADR-0013: ランタイム基盤は platform 由来の最小移植 shim（本番非使用の足場）を参照する。 -->
    <ProjectReference Include="..\..\..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
    <InternalsVisibleTo Include="NotificationService.Worker.Tests" />
  </ItemGroup>
</Project>
