<!-- NFR/IADR-0259 決定4: サービス単位のテストは 1 プロジェクトへ統合する（旧 Api/Application/Infrastructure
     の 3 本を統合。中身は移送のみで変えていない）。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <ProjectReference Include="..\NotificationService.csproj" />
    <!-- FR-07, FR-14, FR-20, #957, IADR-0408（2026-09-25 追記）: 報告書のレビュー照会・リスク管理の段階ゲートの契約テスト
         （T-10-913〜916）が送り手の本物の型を直列化するためのテスト専用参照。`Program` の曖昧を避けて extern alias で参照する
         （AiStockTrading.IntegrationTests と同じ別名）。 -->
    <ProjectReference Include="..\..\ReportService\ReportService.csproj" Aliases="ReportWorker" />
    <!-- FR-10, FR-14, FR-19, #957, IADR-0408（2026-09-25 追記・C）: 次のリスク管理への参照は、kill switch・一時停止・稼働状態・
         GFV 解除の契約テスト（T-10-932〜935）も送り手の本物の型の直列化に使う。 -->
    <ProjectReference Include="..\..\RiskManagementService\RiskManagementService.csproj" Aliases="RiskManagementWorker" />
    <!-- FR-10, FR-09, #879, IADR-0424: 見送り（OrderDispatchForgone）の越境の契約テスト（T-10-1007）が、送り手（発注執行）の
         本物の OrderExecutionAppService で見送りを作るためのテスト専用参照。`Program` の曖昧を避けて extern alias で参照する。 -->
    <ProjectReference Include="..\..\OrderExecutionService\OrderExecutionService.csproj" Aliases="OrderExecutionWorker" />
    <!-- NFR, #947, IADR-0397: 本番の組み立て（Program.cs）を組んで配線の抜けを検査する共有ガード。 -->
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.Composition\AiStockTrading.TestSupport.Composition.csproj" />
    <!-- ADR-0013, IADR-0129, #354: Wolverine のハンドラをランタイム生成で動かすため（RuntimeCompilation）、
         共通配線ヘルパを持つ shim をテストからのみ参照する。 -->
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.Messaging\AiStockTrading.TestSupport.Messaging.csproj" />
  </ItemGroup>
</Project>
