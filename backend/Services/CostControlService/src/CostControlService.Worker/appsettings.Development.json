{
  // 開発（ローカル/compose）用の設定点。実行時は compose の環境変数（`__` 区切り）が最優先で上書きする。
  // env=Testing のテストは本ファイルを読み込まないため、既定挙動（安全既定）に干渉しない（IADR-0048 決定 1）。
  "Serilog": { "MinimumLevel": { "Default": "Debug" } },
  "RabbitMq": { "ConnectionString": "amqp://guest:guest@rabbitmq:5672" },
  "Otlp": { "Endpoint": "http://otel-collector:4317" },
  "ConnectionStrings": { "DefaultConnection": "Host=postgres;Port=5432;Database=cost_control_svc;Username=ai;Password=ai" },
  "Auth": { "Authority": "http://keycloak:8080/realms/ai-stock-trading" },
  // FR-17, #139, IADR-0065: 月次費用上限の取得元（設定サービスの GET /assumptions）。
  // fail-safe: 空=HTTP を構築せず前提条件の既定値（20,000/15,000）で判定する＝従来挙動。
  // AssumptionsCacheTtlSeconds 空/不正/非正値=既定 300 秒（AssumptionsChanged 購読による無効化の保険）。
  "Configuration": { "BaseUrl": "", "AssumptionsCacheTtlSeconds": "" },
  // #137, IADR-0059: processed_messages の保持期間パージ。既定は無効（不可逆な DELETE はオプトイン）。
  // RetentionDays は下限 7 日でクランプされるため、設定ミスで重複排除（＝二重計上の防止）は壊れない。
  "Retention": { "Enabled": false, "RetentionDays": 90, "IntervalHours": 24, "BatchSize": 500 }
}
