<!-- #19 Slice A, FR-17, IADR-0021, NFR/IADR-0259 決定1, IADR-0264: 設定管理サービス。単一プロジェクト＋
     VSA/DDD フォルダ構成（層プロジェクト .Api/.Application/.Domain/.Infrastructure と、他サービスへ公開する
     クライアント .Client は撤去し、Features/・Common/・Infrastructure/ のフォルダで境界を表す。基盤
     MSP:IADR-0282 決定1 と同一樹形）。全体前提条件のバージョン管理・変更履歴・利用者変更（Keycloak 認可）と
     ヘルスチェックのため Web SDK を使用。更新時に AssumptionsChanged を発行する（Wolverine）。実行時基盤は
     test-support shim（本番非使用・IADR-0013）。 -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!-- Tests/ は独立プロジェクトなので本プロジェクトのコンパイル対象から外す
         （入れ子のままだと二重コンパイルで CS0246 が出る。基盤が実測済み・NFR/IADR-0259）。 -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- NFR, IADR-0331 決定2, #745 (#584): east-west gRPC 段 1 の線上写像（AssumptionsWireMapping）は
         公開面ではないが、`decimal` の桁が線上で失われないことを単体で固定する必要があるため試験にだけ見せる
         （Shared.KnowledgeBase・PlatformShim と同じ形）。 -->
    <InternalsVisibleTo Include="ConfigurationService.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR-0013, IADR-0129, #354: メッセージングは Wolverine（RabbitMQ）。共通配線は shim の WolverineExtensions。 -->
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34 準拠: Relational を直接ピンし Npgsql と Design の推移依存衝突（MSB3277）を避ける。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- dotnet ef の startup project となるため Design を保持する。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <!-- FR-17: 更新通知 AssumptionsChanged を発行するため共有イベント契約を参照する。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Contracts\AiStockTrading.Shared.Contracts.csproj" />
    <!-- NFR, IADR-0328 決定4, IADR-0331 決定7, #745 (#584): east-west gRPC の proto 契約と生成物。
         Shared.Contracts へは置けない（Domain 到達可能・外部ライブラリ依存ゼロの制約）。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Grpc\AiStockTrading.Shared.Grpc.csproj" />
    <!-- FR-17, NFR/IADR-0260/IADR-0264 決定2: 全体前提条件（TradingAssumptions）と版付きの型
         （VersionedAssumptions）はサービスを跨いで消費されるため共有カーネルに置く。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Kernel\AiStockTrading.Shared.Kernel.csproj" />
    <!-- IADR-0013: ランタイム基盤は platform 由来の最小移植 shim（本番非使用の足場）を参照する。 -->
    <ProjectReference Include="..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
  </ItemGroup>
</Project>
