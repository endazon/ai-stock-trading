<!-- #19 Slice A, FR-17, IADR-0021, IADR-0128: 設定管理サービスの技術詳細（EF Core 永続化・Migration）。
     ホスト（Program.cs・エンドポイント・DI 構成）は Api に置く。共有フレームワーク型（IOptions/ILogger/
     Hosting 等）を使うため FrameworkReference を持つ（TestSupport.PlatformShim と同型）。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>ConfigurationService.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34 準拠: Relational を直接ピンし Npgsql と Design の推移依存衝突（MSB3277）を避ける。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="..\ConfigurationService.Application\ConfigurationService.Application.csproj" />
    <!-- IADR-0128: 永続化の実装型は internal のまま据え置き、composition root（Api）とその
         テストにだけ可視にする。public へ広げると分割前に無かった公開面が生まれ、
         「再配置＝振る舞いも公開面も変えない」という本移行の前提が崩れる。 -->
    <InternalsVisibleTo Include="ConfigurationService.Api" />
    <InternalsVisibleTo Include="ConfigurationService.Api.Tests" />
    <InternalsVisibleTo Include="ConfigurationService.Infrastructure.Tests" />
  </ItemGroup>
</Project>
