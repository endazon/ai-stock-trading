<!-- FR-15, #208, IADR-0105, IADR-0128, NFR/IADR-0259 決定1: バックテストサービス。単一プロジェクト＋
     VSA/DDD フォルダ構成（層プロジェクト .Api/.Application/.Domain/.Infrastructure は撤去し、Features/・Domain/・
     Infrastructure/ のフォルダで境界を表す。基盤 MSP:IADR-0282 決定1 と同一樹形）。ヘルスチェックと実効構成の
     自己申告（GET /internal/introspection）のため Web SDK を使用する。DB・メッセージバスは持たない
     （永続化は無く、verdict の実 publish は #82）。実過去データ源のアダプタ（Stooq・moomoo）は
     Infrastructure/ExternalServices/ に置く。実行時基盤は test-support shim（IADR-0013）。 -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!-- Tests/ は独立プロジェクトなので本プロジェクトのコンパイル対象から外す
         （入れ子のままだと二重コンパイルで CS0246 が出る。基盤が実測済み・NFR/IADR-0259）。 -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <!-- ADR-0023 決定5, IADR-0157: 米国株日足 OHLC の履歴源（moomoo OpenAPI の履歴 K 線）。
         発注経路（OrderExecutionService）と同一バージョンの SDK を使う。 -->
    <PackageReference Include="moomoo-api" />
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Contracts\AiStockTrading.Shared.Contracts.csproj" />
    <!-- IADR-0043, NFR, IADR-0260: 符号付き在庫の畳み込み（SignedInventory）と Market を共有する。
         サービスを跨いで共有する Domain 型（全体前提条件・概算費用関数・運用段階）。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Kernel\AiStockTrading.Shared.Kernel.csproj" />
    <!-- #208, IADR-0105 決定 5: 外部データ源のレート制御（IRateLimiter / TokenBucket・IADR-0064）を再利用する。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Infrastructure\AiStockTrading.Shared.Infrastructure.csproj" />
    <!-- IADR-0013: ランタイム基盤は platform 由来の最小移植 shim（本番非使用の足場）を参照する。 -->
    <ProjectReference Include="..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
  </ItemGroup>
</Project>
