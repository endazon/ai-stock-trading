{
  // 開発（ローカル/compose）用の設定点。実行時は compose の環境変数（`__` 区切り）が最優先で上書きする。
  // env=Testing のテストは本ファイルを読み込まないため、既定挙動（安全既定）に干渉しない（IADR-0048 決定 1）。
  "Serilog": { "MinimumLevel": { "Default": "Debug" } },
  "Otlp": { "Endpoint": "http://otel-collector:4317" },
  // FR-15, ADR-0004, #208, IADR-0105: バックテストの実過去データ源。
  // fail-safe: 空/"none"/未知の値/不正な BaseUrl はすべて no-op＝**外部へ 1 リクエストも出さない**。
  // "stooq" を指定すると Stooq（日足 EOD・登録不要）から実過去データを取得する（鍵は不要）。
  // RequestsPerMinute は当サービスに配るレート予算。Stooq は上限を公表しておらず SLA も無いため保守的に既定 10。
  // FR-15, FR-20, ADR-0008, ADR-0033, #688, IADR-0310: Stage 0 判定の定時駆動。
  // fail-safe: **既定は無効**（Enabled=false）。無効なら巡回もバー取得も verdict の発行も起きない。
  // 有効化しても、本番戦略（AI 判断の記録・再生）が載るまで verdict は**不合格固定**である（経路確認専用）。
  // LlmTrainingCutoff は未設定＝検証条件①を未充足として扱う（未設定を充足へ倒さない）。
  "Backtest": {
    "BarData": { "Provider": "", "Stooq": { "BaseUrl": "", "RequestsPerMinute": 10 } },
    "Stage0": { "Enabled": false, "IntervalSeconds": 86400, "LookbackDays": 365, "LlmTrainingCutoff": "", "Symbols": [] }
  }
}
