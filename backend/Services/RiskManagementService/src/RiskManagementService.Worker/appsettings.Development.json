{
  // 開発（ローカル/compose）用の設定点。実行時は compose の環境変数（`__` 区切り）が最優先で上書きする。
  // env=Testing のテストは本ファイルを読み込まないため、既定挙動（安全既定）に干渉しない（IADR-0048 決定 1）。
  "Serilog": { "MinimumLevel": { "Default": "Debug" } },
  "RabbitMq": { "ConnectionString": "amqp://guest:guest@rabbitmq:5672" },
  "Otlp": { "Endpoint": "http://otel-collector:4317" },
  "ConnectionStrings": { "DefaultConnection": "Host=postgres;Port=5432;Database=risk_management_svc;Username=ai;Password=ai" },
  "Auth": { "Authority": "http://keycloak:8080/realms/ai-stock-trading" },
  // #81, IADR-0066: 時価評価（含み損益・DD）。EnableMarkToMarket=true にすると DrawdownRatio が非 0 になり
  // 最大DD の取引ゲート（IADR-0008）の判定入力が変わるため、実市況の live 検証を経てから人手で切り替える。
  // 現在値ソース自体も既定 no-op（実接続しない）のため、true にしても実市況が入るまでは含み 0・DD 0 のまま。
  // #158, IADR-0068: Provider=finnhub＋Finnhub:ApiKey（環境変数 MARKETDATA_FINNHUB_API_KEY）で実市況を opt-in する。
  // 既定 none は実接続しない。RequestsPerMinute は当サービスへ配るレート予算（全プロセス合計を 60/分以内に保つ）。
  // FR-10/12, #257, IADR-0108: SIMULATE 限定のリスク上限プロファイル（moomoo シミュレータ残高 $1M/¥20M 相当）。
  // false（既定）＝本番既定（初期資金 ¥100,000／1 注文 ¥35,000）。true で基準資金 ¥170,000,000・
  // 1 注文 ¥59,500,000・日次 ¥170,000,000 へ引き上げ、米国株（AAPL ≒ ¥50,250/株）の発注が成立する。
  // 上限値は Domain 定数（SimulatorTradingDefaults）が単一情報源で、構成からは有効/無効しか選べない。
  // 実弾段階（Stage 2/3）の資金上限は有効時も本番既定のまま（IADR-0108 決定4）。
  "Risk": { "SimulatorProfile": { "Enabled": false } },
  "MarketData": {
    "EnableMarkToMarket": false,
    "RefreshIntervalSeconds": 60,
    "MaxQuoteStalenessSeconds": 300,
    "Provider": "none",
    "Finnhub": { "ApiKey": "", "RequestsPerMinute": 10 }
  }
}
