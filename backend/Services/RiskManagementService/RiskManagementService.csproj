<!-- #12 Slice B, IADR-0010/0011/0012, IADR-0128, NFR/IADR-0259 決定1, IADR-0263/IADR-0264 決定3:
     リスク管理サービス。単一プロジェクト＋VSA/DDD フォルダ構成（層プロジェクト .Api/.Application/.Domain/
     .Infrastructure は撤去し、Features/・Domain/・Common/・Infrastructure/・Hosted/ のフォルダで境界を表す。
     基盤 MSP:IADR-0282 決定1 と同一樹形）。kill switch/設定変更の HTTP エンドポイント（Keycloak 認可）と
     ヘルスチェックのため Web SDK を使用。EF Core 永続化と Migration（Infrastructure/Persistence/）、
     各種 consumer（TradeDecisionMade / OrderApproved / OrderExecuted / StopLossTriggered 等・
     Infrastructure/Steps/）、現在値キャッシュ（Infrastructure/ExternalServices/）、段階ゲートと撤退評価・
     現在値補充の常駐ジョブ（Hosted/）を持つ。 -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!-- Tests/ は独立プロジェクトなので本プロジェクトのコンパイル対象から外す
         （入れ子のままだと二重コンパイルで CS0246 が出る。基盤が実測済み・NFR/IADR-0259）。 -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR-0013, IADR-0129, #354: メッセージングは Wolverine（RabbitMQ）。共通配線は shim の WolverineExtensions。 -->
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34 準拠: Relational を直接ピンし Npgsql と Design の推移依存衝突（MSB3277）を避ける。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- dotnet ef の startup project となるため Design を保持する。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Contracts\AiStockTrading.Shared.Contracts.csproj" />
    <!-- NFR, IADR-0260: サービスを跨いで共有する Domain 型（全体前提条件・概算費用関数・運用段階）。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Kernel\AiStockTrading.Shared.Kernel.csproj" />
    <!-- IADR-0066: 現在値ソース（既定 no-op）と手元保持（QuoteCache）は共有物を用いる。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Infrastructure\AiStockTrading.Shared.Infrastructure.csproj" />
    <!-- IADR-0013: ランタイム基盤は platform 由来の最小移植 shim（本番非使用の足場）を参照する。
         本番では platform 本体の Foundation に置き換わる。standalone 起動配線は dev/test/CI 用。 -->
    <ProjectReference Include="..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
  </ItemGroup>
</Project>
