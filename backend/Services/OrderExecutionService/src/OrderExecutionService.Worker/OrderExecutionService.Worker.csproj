<!-- #13 Slice A, IADR-0013/0016: 発注執行 Worker ホスト。ヘルスチェックの HTTP サーフェスのため Web SDK を使用。
     OrderApproved 購読は MassTransit コンシューマとして稼働する。実行時基盤は test-support shim（本番非使用・IADR-0013）。
     ブローカ既定はペーパー（実弾を撃たない・IADR-0016）。 -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>AiStockTrading.OrderExecution.Worker</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="moomoo-api" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <ProjectReference Include="..\OrderExecutionService.Application\OrderExecutionService.Application.csproj" />
    <!-- 安全なペーパーブローカ（本番実装・FR-12）。既定のブローカ実装。 -->
    <ProjectReference Include="..\..\..\..\Shared\AiStockTrading.Shared.Infrastructure\AiStockTrading.Shared.Infrastructure.csproj" />
    <!-- IADR-0013: ランタイム基盤は platform 由来の最小移植 shim（本番非使用の足場）。 -->
    <ProjectReference Include="..\..\..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
    <InternalsVisibleTo Include="OrderExecutionService.Worker.Tests" />
  </ItemGroup>
</Project>
