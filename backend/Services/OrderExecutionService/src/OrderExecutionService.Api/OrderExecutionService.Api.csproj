<!-- #13 Slice A, IADR-0013/0016, IADR-0128: 発注執行サービスの API ホスト。ヘルスチェックの HTTP サーフェスのため
     Web SDK を使用。実行時基盤は test-support shim（本番非使用・IADR-0013）。ブローカ既定はペーパー
     （実弾を撃たない・IADR-0016）。技術詳細（EF Core 永続化・ブローカアダプタ・consumer・常駐ジョブ）は
     Infrastructure に置く。 -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>AiStockTrading.OrderExecution.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- ADR-0013, IADR-0129, #354: メッセージングは Wolverine（RabbitMQ）。共通配線は shim の WolverineExtensions。 -->
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- dotnet ef の startup project となるため Design を保持する（Migration 本体は Infrastructure）。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <ProjectReference Include="..\OrderExecutionService.Application\OrderExecutionService.Application.csproj" />
    <!-- IADR-0128 決定 1: 具象実装（EF ストア・DbContext・ブローカ・consumer・常駐ジョブ）の DI 登録は composition root（Api）が行う。 -->
    <ProjectReference Include="..\OrderExecutionService.Infrastructure\OrderExecutionService.Infrastructure.csproj" />
    <!-- 安全なペーパーブローカ（本番実装・FR-12）。既定のブローカ実装。 -->
    <ProjectReference Include="..\..\..\..\Shared\AiStockTrading.Shared.Infrastructure\AiStockTrading.Shared.Infrastructure.csproj" />
    <!-- IADR-0013: ランタイム基盤は platform 由来の最小移植 shim（本番非使用の足場）。 -->
    <ProjectReference Include="..\..\..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
    <InternalsVisibleTo Include="OrderExecutionService.Api.Tests" />
  </ItemGroup>
</Project>
