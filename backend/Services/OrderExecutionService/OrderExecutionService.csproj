<!-- #13 Slice A, IADR-0013/0016, NFR/IADR-0259 決定1, IADR-0263/IADR-0264 決定3: 発注執行サービス。
     単一プロジェクト＋VSA/DDD フォルダ構成（層プロジェクト .Api/.Application/.Domain/.Infrastructure は撤去し、
     Features/・Domain/・Common/・Infrastructure/・Hosted/ のフォルダで境界を表す。基盤 MSP:IADR-0282 決定1 と
     同一樹形）。ヘルスチェックの HTTP サーフェスのため Web SDK を使用。実行時基盤は test-support shim
     （名は足場だが配備でも動く実行時の配線・IADR-0013 の 2026-10-07 追記）を参照する。ブローカ既定はペーパー（実弾を撃たない・IADR-0016）。
     moomoo（OpenD）ブローカアダプタ（Infrastructure/ExternalServices/）、OrderApproved の consumer
     （Infrastructure/Steps/）、約定ポーリング/建玉突合/予約保持/保護逆指値ガード/ブローカ稼働観測の
     常駐ジョブ（Hosted/）、EF Core 永続化（Infrastructure/Persistence/）を持つ。 -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!-- Tests/ は独立プロジェクトなので本プロジェクトのコンパイル対象から外す
         （入れ子のままだと二重コンパイルで CS0246 が出る。基盤が実測済み・NFR/IADR-0259）。 -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- #1117（PR #1119 の監査 F3）: MMAPI.Init の二重化防止（internal の OnceInitializer）を試験から直接組み立てる
         （NotificationService / ConfigurationService / CostControlService / TradeDecisionService と同じ作法）。 -->
    <InternalsVisibleTo Include="OrderExecutionService.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR-0013, IADR-0129, #354: メッセージングは Wolverine（RabbitMQ）。共通配線は shim の WolverineExtensions。 -->
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <!-- #1442, IADR-0573 決定1: 送信の耐久アウトボックス（PostgreSQL）。 -->
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34 準拠: Relational を直接ピンし Npgsql と Design の推移依存衝突（MSB3277）を避ける。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- dotnet ef の startup project となるため Design を保持する。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <!-- moomoo（OpenD）SDK。IMoomooTradeClient の本番実装（MMApiMoomooTradeClient）が使う。 -->
    <PackageReference Include="moomoo-api" />
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Contracts\AiStockTrading.Shared.Contracts.csproj" />
    <!-- NFR, IADR-0331 決定7, IADR-0559, #1391 (#753): east-west gRPC（段 5 の追補 2・読み取り）の proto 契約と生成物。
         Shared.Contracts へは置けない（Domain 到達可能・外部ライブラリ依存ゼロの制約）。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Grpc\AiStockTrading.Shared.Grpc.csproj" />
    <!-- 🔴 ADR-0067, #1339, IADR-0539: 判断由来の決済の取消の既定値・検知の窓（DecisionCloseUnfilledCancelDefaults）と市場の現地取引日（MarketHours.ZoneOf）。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Kernel\AiStockTrading.Shared.Kernel.csproj" />
    <!-- 安全なペーパーブローカ（本番実装・FR-12）。既定のブローカ実装。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Infrastructure\AiStockTrading.Shared.Infrastructure.csproj" />
    <!-- IADR-0013: ランタイム基盤は platform 由来の最小移植 shim（名は足場だが配備でも動く実行時の配線。IADR-0013 の 2026-10-07 追記）。 -->
    <ProjectReference Include="..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
  </ItemGroup>
</Project>
