<!-- #17 Slice A, FR-11, IADR-0019, IADR-0128: 監査ログサービスの技術詳細（EF Core 監査台帳・Migration・
     全ドメインイベントの consumer）。ホスト（Program.cs・エンドポイント・DI 構成）は Api に置く。
     共有フレームワーク型（IOptions/ILogger/Hosting 等）を使うため FrameworkReference を持つ
     （TestSupport.PlatformShim と同型）。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>AiStockTrading.Audit.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- ADR-0013, IADR-0129, #354: メッセージングは Wolverine（ハンドラ規約・Envelope）。 -->
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34 準拠: Relational を直接ピンし Npgsql と Design の推移依存衝突（MSB3277）を避ける。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="..\AuditService.Application\AuditService.Application.csproj" />
    <!-- IADR-0128: 実装型は internal のまま据え置き、composition root（Api）とその
         テストにだけ可視にする。public へ広げると分割前に無かった公開面が生まれる。 -->
    <InternalsVisibleTo Include="AuditService.Api" />
    <InternalsVisibleTo Include="AuditService.Api.Tests" />
    <InternalsVisibleTo Include="AuditService.Infrastructure.Tests" />
  </ItemGroup>
</Project>
