<!-- #14 Slice A, FR-06/07, IADR-0024, NFR/IADR-0259 決定1, IADR-0263/IADR-0264 決定3: 報告書サービス。
     単一プロジェクト＋VSA/DDD フォルダ構成（層プロジェクト .Api/.Application/.Domain/.Infrastructure は撤去し、
     Features/・Domain/・Common/・Infrastructure/・Hosted/ のフォルダで境界を表す。基盤 MSP:IADR-0282 決定1 と
     同一樹形）。確定管理（版番号付き冪等・Keycloak 認可）・確定済み日報方針の照会とヘルスチェックのため
     Web SDK を使用。確定遷移時に ReportConfirmed を発行する。実行時基盤は test-support shim
     （本番非使用・IADR-0013）。EF Core 永続化（Infrastructure/Persistence/）、叙述生成・KB 写像・期間供給の
     外部接続アダプタ（Infrastructure/ExternalServices/）、自動生成の常駐ジョブ（Hosted/）を持つ。
     Wolverine の consumer は持たないため Infrastructure/Steps/ は無い。 -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!-- Tests/ は独立プロジェクトなので本プロジェクトのコンパイル対象から外す
         （入れ子のままだと二重コンパイルで CS0246 が出る。基盤が実測済み・NFR/IADR-0259）。 -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR-0013, IADR-0129, #354: メッセージングは Wolverine（RabbitMQ）。共通配線は shim の WolverineExtensions。 -->
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34 準拠: Relational を直接ピンし Npgsql と Design の推移依存衝突（MSB3277）を避ける。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- dotnet ef の startup project かつ Migration の所在でもあるため Design を保持する。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Contracts\AiStockTrading.Shared.Contracts.csproj" />
    <!-- NFR, IADR-0260: サービスを跨いで共有する Domain 型（全体前提条件・概算費用関数・運用段階）。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Kernel\AiStockTrading.Shared.Kernel.csproj" />
    <!-- IADR-0066: 現在値ソース（既定 no-op・前回値フォールバック）。
         NFR（費用）, #347, IADR-0219: 報告書生成の LLM 費用計上に単価表（LlmPriceTable / LlmPricing）を用いる。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Infrastructure\AiStockTrading.Shared.Infrastructure.csproj" />
    <!-- FR-08, IADR-0069/0071: 確定報告書の KB 保存（既定 no-op・BaseUrl 設定で opt-in）。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.KnowledgeBase\AiStockTrading.Shared.KnowledgeBase.csproj" />
    <!-- IADR-0013: ランタイム基盤は platform 由来の最小移植 shim（本番非使用の足場）を参照する。 -->
    <ProjectReference Include="..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
  </ItemGroup>
</Project>
