<!-- NFR/IADR-0259 決定4: サービス単位のテストは 1 プロジェクトへ統合する（旧 Api/Application/Domain/Infrastructure
     の 4 本を統合。中身は移送のみで変えていない）。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <ProjectReference Include="..\ReportService.csproj" />
    <!-- ADR-0013, IADR-0129, #354, #335, #347: 本番と同じ Wolverine 配線でホストを起こし、発行アダプタ
         （PublishingLlmUsageReporter / PublishingLlmGovernanceReporter）が実際にイベントを publish することを
         検証するため、共通配線ヘルパと追跡ハーネスを参照する（旧 Infrastructure.Tests から引き継いだ）。 -->
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.PlatformShim\AiStockTrading.TestSupport.PlatformShim.csproj" />
    <ProjectReference Include="..\..\..\TestSupport\AiStockTrading.TestSupport.Messaging\AiStockTrading.TestSupport.Messaging.csproj" />
    <!-- FR-06, FR-10, #943, IADR-0390: 日報 §3 が読む GET /risk-controls/open-positions の契約テスト（T-10-804）が
         送り手の本物の型（OpenPositionView）を直列化するためのテスト専用参照。本体（ReportService.csproj）は参照しない。
         移送先は Web SDK で `public partial class Program` を持つため、`Program` の曖昧（CS0433）を避けて extern alias で参照する
         （TradeDecisionService.Tests・AiStockTrading.IntegrationTests と同じ別名）。 -->
    <ProjectReference Include="..\..\RiskManagementService\RiskManagementService.csproj" Aliases="RiskManagementWorker" />
  </ItemGroup>
  <ItemGroup>
    <!-- FR-06, #338: 報告書テンプレートのゴールデンファイル（種別 × 供給あり/なし）。
         テスト実行ディレクトリへ複写し、実出力とバイト単位で突き合わせる。
         NFR/IADR-0289 決定5: ゴールデンは ReportTemplateGoldenTests と対で Domain/ の鏡写しへ移した
         （UPDATE_GOLDEN=1 がテストのソース位置から相対で書き戻すため、対を離せない）。Link で
         出力先を Golden\ に固定し、AppContext.BaseDirectory からの読み取りパスは移送前と同じに保つ。 -->
    <None Include="Domain\Golden\*.md" CopyToOutputDirectory="PreserveNewest" Link="Golden\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
