<!-- #14 Slice A, FR-06/07, IADR-0024, IADR-0128: 報告書サービスの技術詳細（EF Core 永続化・Migration・
     叙述生成アダプタ・KB 写像・自動生成スケジューラ・期間約定の照会）。ホスト（Program.cs・エンドポイント・
     DI 構成）は Api に置く。共有フレームワーク型（BackgroundService/IOptions/ILogger 等）を使うため
     FrameworkReference を持つ（TestSupport.PlatformShim と同型）。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>AiStockTrading.Report.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- ADR-0013, IADR-0129, #354: メッセージングは Wolverine（IMessageBus による発行）。 -->
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34 準拠: Relational を直接ピンし Npgsql と Design の推移依存衝突（MSB3277）を避ける。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="..\ReportService.Application\ReportService.Application.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\AiStockTrading.Shared.Contracts\AiStockTrading.Shared.Contracts.csproj" />
    <!-- FR-08, IADR-0069/0071: 確定報告書の KB 保存（既定 no-op・BaseUrl 設定で opt-in）は共有クライアントを用いる。 -->
    <ProjectReference Include="..\..\..\..\Shared\AiStockTrading.Shared.KnowledgeBase\AiStockTrading.Shared.KnowledgeBase.csproj" />
    <!-- IADR-0128: 実装型は internal のまま据え置き、composition root（Api）とその
         テストにだけ可視にする。public へ広げると分割前に無かった公開面が生まれる。 -->
    <InternalsVisibleTo Include="ReportService.Api" />
    <InternalsVisibleTo Include="ReportService.Api.Tests" />
    <InternalsVisibleTo Include="ReportService.Infrastructure.Tests" />
  </ItemGroup>
</Project>
