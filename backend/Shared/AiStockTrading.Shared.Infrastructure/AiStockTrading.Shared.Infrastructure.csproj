<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- IADR-0066: 既定 no-op の現在値ソースが差し替え漏れを警告するためのログ抽象（実装には依存しない）。 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- FR-10, ADR-0022, IADR-0286: 為替レート源（日銀・FRED）を共有化した。FRED は API キーをクエリで渡すため、
         OTel の HttpClient 計装を当該要求だけ抑止する（SuppressInstrumentationScope・IADR-0064）。 -->
    <PackageReference Include="OpenTelemetry" />
    <!-- NFR, FR-04, FR-06, MSP:ADR-0029, IADR-0284, IADR-0328, IADR-0332, #746: east-west gRPC の呼び出し側。
         Grpc.Net.Client = 平文 h2c チャネルと生成クライアントの基底、Google.Protobuf = 生成コードの実行時、
         Grpc.Tools = ビルド時の生成器（成果物には載せないので PrivateAssets=all）。
         🔴 **これらを AiStockTrading.Shared.Contracts へ置いてはならない** —— 同プロジェクトは Domain から
         到達でき、「Domain は .NET 標準のみ」（MSP:ADR-0030 §基本方針 / IADR-0256）を迂回させないため
         PackageReference ゼロで保たれている（`SharedProjectDependencyTests` が実測で止める）。 -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- IADR-0328 決定4 / IADR-0332 決定1: proto のパスは**所有者**のユニット・サービス・版に従う
         （所有者は基盤の LlmGateway であって AST ではない）。**本リポジトリは呼び出し側だけ**を生成する。
         生成物は obj/ に落ち、コミットしない。 -->
    <Protobuf Include="Protos/**/*.proto" ProtoRoot="Protos" GrpcServices="Client" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiStockTrading.Shared.Contracts\AiStockTrading.Shared.Contracts.csproj" />
  </ItemGroup>
</Project>
