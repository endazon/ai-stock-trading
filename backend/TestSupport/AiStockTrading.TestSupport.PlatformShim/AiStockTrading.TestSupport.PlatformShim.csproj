<!-- IADR-0013: microservices-platform 由来のランタイム Foundation の最小移植（shim）。
     🔴 #1204, IADR-0013（2026-10-07 追記）: 名は「足場」だが、**本リポから組む各サービスの配備で実際に動く実行時の配線**
     である（バス・可観測性・認証・例外応答〔IADR-0496〕・gRPC の所有者の門〔GrpcOwnerClientGate。Discord ボットの azp。IADR-0448〕）。
     「本番では platform 本体の Foundation を用いるので本番非使用」という当初の前提は、差し替え（#22）が行われずに
     クローズしたため成り立たない。変更は配備の挙動を変える。詳細は ../README.md。
     ASP.NET 型（WebApplication/HttpContext/HealthChecks）を使うため共有フレームワークを参照する。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>AiStockTrading.TestSupport.PlatformShim</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- NFR, MSP:ADR-0029, IADR-0284 決定5（段0）, IADR-0328, #584: east-west gRPC の共通配線。
         Grpc.AspNetCore = 受け側（AddGrpc / MapGrpcService と h2c リスナ）、Grpc.Net.Client = 呼び出し側
         （s2s トークン付きの平文チャネル）。 -->
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <!-- NFR, ADR-0013, IADR-0129, #354: Wolverine の共通配線（WolverineExtensions）。
         MassTransit（旧 MassTransitExtensions）は #354 第 3 段階で撤去済み。 -->
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>
  <ItemGroup>
    <!-- NFR-07, #287, IADR-0255: 業務メトリクスの計器（BusinessMetrics）は契約プロジェクトが持つ。
         可観測性の配線は 11 サービスが等しく通る本 shim にしか無いため、DI 登録と AddMeter をここで行う。 -->
    <ProjectReference Include="..\..\Shared\AiStockTrading.Shared.Contracts\AiStockTrading.Shared.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- IADR-0328, #584: h2c リスナの構成解決（ポート・ホスティング URL・待受ホスト）は公開面ではないが、
         「HTTP ポートが消えない」「0 は立てない」を単体で固定する必要があるため試験にだけ見せる
         （Shared.KnowledgeBase と同じ形。基盤 Platform.Shared.Infrastructure も同様）。 -->
    <InternalsVisibleTo Include="AiStockTrading.TestSupport.PlatformShim.Tests" />
  </ItemGroup>
</Project>
