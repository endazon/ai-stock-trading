# =============================================================================
# ai-stock-trading ローカル実行環境 .env（テンプレート） — issue #107 / IADR-0048
# -----------------------------------------------------------------------------
# 使い方: このファイルを `.env` にコピーして値を編集する（`.env` は .gitignore 済み）。
#   cp .env.example .env
#   docker compose up
# 本ファイルには「キー名と用途コメント」のみを置く。**実値・実シークレットは書かない**。
# 機密（LLM/証券会社/Webhook 等）は空既定。有効化は明示設定時のみ（fail-safe）。
# 本番の資格情報は Vault/Secrets（ADR-0006 / #24）に委ね、本ファイルでは扱わない。
# =============================================================================

# --- PostgreSQL（dev ダミー。Database-per-Service: init が 7 専有 DB を作成する） ---
POSTGRES_USER=ai
POSTGRES_PASSWORD=ai

# --- RabbitMQ（dev ダミー。管理 UI: http://localhost:15672） ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- Keycloak（dev モード。管理コンソール: http://localhost:8081） ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# 実現するレルム名（realm-export.json と一致させる）。OwnerOnly 認可の検証は #82。
KEYCLOAK_REALM=ai-stock-trading

# --- 可観測性（OpenTelemetry Collector） ---
OTLP_ENDPOINT=http://otel-collector:4317

# =============================================================================
# fail-safe 有効化ポイント（既定は空＝各サービスは安全既定へ倒れる）
# 空のままなら: 実 LLM を呼ばない / 実市場データに接続しない / 実発注しない / 外部送信しない。
# =============================================================================

# 実 LLM エグレス（取引判断の実 LLM 連携）。空=呼ばない（Placeholder が常に Hold＝取引しない）。
#   LLM_GATEWAY_BASEURL         platform LLM ゲートウェイ（POST /complete）。例: http://llmgateway-service.microservices-platform:8080
#   LLM_GATEWAY_TIMEOUTSECONDS  応答待ちの上限（秒）。空/不正/非正値=既定 30。
#   LLM_GATEWAY_LOGPROMPTS      プロンプト・生出力を全量ログに残すか（FR-11）。空=残さない。
#     プロンプトは保有ポジション・資金残枠等の機微を含むため既定オフ。調査時のみ true にする（IADR-0061 決定1）。
LLM_GATEWAY_BASEURL=
LLM_GATEWAY_TIMEOUTSECONDS=
LLM_GATEWAY_LOGPROMPTS=
# LLM プロバイダ鍵（Anthropic 等）は **AST では扱わない**。鍵は MSP の LlmGateway 側（Llm:ApiKey）が保持し、
# AST はゲートウェイ経由でのみ LLM を呼ぶ（ADR-0010 / IADR-0061 決定6）。ここに鍵のキーを増やさないこと。
# 上記 LLM_GATEWAY_* は取引判断（#11）に加え、報告書サービスの散文ドラフト（FR-06/IADR-0071）でも用いる（同じゲートウェイ）。

# 確定報告書のナレッジベース保存（FR-08 / IADR-0069 / IADR-0071）。空=no-op（保存しない＝現行挙動）。
#   KNOWLEDGE_BASE_DOCUMENTS_BASEURL  platform 文書管理（DocumentService）の POST /documents。設定時のみ保存を opt-in。
#   保存には SERVICEAUTH_*（下記）による s2s トークンも要る（空なら 401 で未保存＝fail-safe）。
KNOWLEDGE_BASE_DOCUMENTS_BASEURL=

# 報告書の無応答時の既定動作（FR-07 / IADR-0071 決定2）。空/不正=ContinueLastConfirmed（直近の確定済み方針を継続＝安全既定）。
#   ContinueLastConfirmed | Halt（停止）。翌営業日開場までに確定応答が無い場合の挙動。
REPORTS_NORESPONSE_BEHAVIOR=

# 情報収集の実ソース。空=NoOp（外部接続しない）。案A+（ADR-0004）は複数ソースをカンマ区切りで指定する
# （例: finnhub,sec-edgar,edinet,boj,fred）。列挙しても当該ソースの必須設定が空なら、そのソースだけ無効になる
# （他のソースは有効なまま・IADR-0064）。銘柄・CIK・系列コードの一覧は 0 始まりの連番で指定する。
COLLECTION_SOURCE_PROVIDER=
# Finnhub Free（米国株の市況・60回/分）。
COLLECTION_FINNHUB_API_KEY=
COLLECTION_FINNHUB_SYMBOLS_0=
# SEC EDGAR（米国の開示・キー不要）。UserAgent は SEC 規約で必須の連絡先（空なら本ソースは無効）。
#   例: COLLECTION_SECEDGAR_USERAGENT="AiStockTrading/1.0 (owner@example.com)"
#   例: COLLECTION_SECEDGAR_CIKS_0=320193（Apple）
COLLECTION_SECEDGAR_USERAGENT=
COLLECTION_SECEDGAR_CIKS_0=
# EDINET API v2（日本の開示・要 API キー登録）。
COLLECTION_EDINET_SUBSCRIPTION_KEY=
# 日銀 時系列統計データ API（キー不要・クレジット表記必須）。DB は統計分類、SERIESCODES は系列コード。
#   例: COLLECTION_BOJ_DB=CO / COLLECTION_BOJ_SERIESCODES_0=TK99F1000601GCQ01000（短観 DI）
COLLECTION_BOJ_DB=
COLLECTION_BOJ_SERIESCODES_0=
# FRED（米マクロ・要 API キー・120回/分）。SERIESIDS は系列 ID（例: DGS10=米10年金利）。
COLLECTION_FRED_API_KEY=
COLLECTION_FRED_SERIESIDS_0=

# 通知の送信手段（例: discord-webhook）。空=NoOp（外部送信しない）。実送信は #15。
NOTIFICATIONS_PROVIDER=
NOTIFICATIONS_DISCORD_WEBHOOK_URL=

# --- Discord Bot（双方向・FR-14 / IADR-0062）。既定 false=Gateway に接続しない ---
# 有効化には Enabled=true・Token に加えて**多層認証の設定がすべて**要る（1つでも欠けたら接続しない）。
# 各 ID が空のままなら着信は全拒否（空＝全許可にはならない・fail-safe）。
DISCORD_BOT_ENABLED=false
# Bot トークン（秘匿）。本番は Vault へ（ADR-0006 / #24）。
DISCORD_BOT_TOKEN=
# 利用者が所有するプライベートサーバー／専用チャンネルの ID。空=全拒否。
DISCORD_BOT_GUILD_ID=
DISCORD_BOT_CHANNEL_ID=
# 操作を受け付ける Discord ユーザーID（本人のみ）。カンマ区切り。空=全拒否。
DISCORD_BOT_ALLOWED_USER_IDS=
# kill switch 起動時に入力を要求する確認フレーズ。空=起動できない（誤爆防止の閂）。
DISCORD_BOT_KILLSWITCH_PHRASE=
# Discord ユーザーID -> Keycloak 利用者名の対応付け（"id:利用者名" のカンマ区切り。例: 123456:endazon）。
#   操作は対応する利用者の権限で実行し、監査ログにも本人として記録する。対応が無いユーザーは操作できない。
DISCORD_BOT_USER_MAPPING=

# Bot が kill switch（Risk の OwnerOnly エンドポイント）を呼ぶための機密クライアント（IADR-0062 決定4）。
#   SERVICEAUTH_*（trading-service）では 403 になるため、**trading-owner をマップした専用クライアント**を使う。
#   空=トークンを付けない（→ 401 で操作は失敗する＝安全側）。
DISCORD_OWNERAUTH_CLIENTID=
DISCORD_OWNERAUTH_CLIENTSECRET=

# 発注ブローカ。既定 paper（実発注しない・IADR-0016）。moomoo 実弾は #13/ADR-0002 PoC 後続。
BROKER_PROVIDER=paper
# moomoo（OpenD）資格情報。空=無効（実弾防止ゲート）。実接続は #13。
MOOMOO_API_KEY=
MOOMOO_API_SECRET=

# --- 実市況（現在値）フィード（FR-10 / #158 / IADR-0068）。既定 none=no-op（外部接続しない） ---
# リスク管理（補充）・市場監視（損切り検知）・報告書（評価損益）が現在値を引く。空/none=実接続しない。
# finnhub＋API キーで opt-in する（手動 live 検証・CI 対象外）。Finnhub Free は米国株のみ・60回/分。
MARKETDATA_PROVIDER=
# Finnhub の API キー（秘匿）。空=no-op（実市況が入らない）。情報収集の COLLECTION_FINNHUB_API_KEY とは別枠
# （有効化の判断もレート予算も別。同じアカウントの鍵を両方へ設定するのは自由）。本番は Vault へ（ADR-0006 / #24）。
MARKETDATA_FINNHUB_API_KEY=
# 時価評価ゲート（リスク管理のみ）。既定 false。true は最大DD の取引ゲート（IADR-0008）の判定入力を変えるため、
# 実市況の live 検証を経てから人手で切り替える（IADR-0066 決定4）。
MARKETDATA_ENABLEMARKTOMARKET=false

# サービス間の同期照会 URL（s2s 認証 #76 完了までは既定 no-op 推奨。空=プレースホルダ）。
#   REPORTS_BASEURL           取引判断->報告書（GET /reports/daily-policy）
#   RISK_MANAGEMENT_BASEURL   取引判断/市場監視->リスク管理（GET /risk-controls/*）
#   COST_CONTROL_BASEURL      情報収集->費用統制（GET /costs/state）
#   CONFIGURATION_BASEURL     費用統制->設定サービス（GET /assumptions）。空=月次費用上限は前提条件の
#                             既定値（20,000/15,000）で判定する＝利用者の上限変更が反映されない（IADR-0065 / #139）。
REPORTS_BASEURL=
RISK_MANAGEMENT_BASEURL=
COST_CONTROL_BASEURL=
CONFIGURATION_BASEURL=

# --- ナレッジベース（platform 文書管理／検索）。既定は空＝no-op（保存しない・検索しない）＝安全既定 ---
# 実 KB 保存（FR-08 / #9 / IADR-0069・0073）: 情報収集が収集情報を platform ナレッジベースへ保存する opt-in。
#   KNOWLEDGEBASE_DOCUMENTS_BASEURL  platform DocumentService（POST /documents）。設定すると実 KB 保存へ切替
#     （空=LoggingKnowledgeBaseSink＝保存しない＝現行動作）。※ 書き込みは platform-admin/operator ロール必須で
#     trading-service は未付与→403→未保存へ fail-safe。実運用はロール付与・本文の object storage 取り込み
#     （Ingestion）が別途前提（後続・platform 側／#82 系 E2E）。
# RAG 取得（FR-08 / #11 / IADR-0069・0072）: 取引判断が収集情報・判断根拠を KB から引いて本判断プロンプトへ注入する。
#   KNOWLEDGEBASE_SEARCH_BASEURL     platform RetrievalService（POST /search）。空=NoOp 検索（参考情報なし＝現行動作）。
#     /search はロールゲート無し（#18）。情報収集自身は未使用だが同一 RetrievalService を指す（設定サーフェスを揃える）。
#   RETRIEVAL_TOPK                   取得件数。空・不正・非正値=既定 5。
# いずれも s2s トークン（下の SERVICEAUTH_*）を client_credentials 導出元に用いる（IADR-0051）。
KNOWLEDGEBASE_DOCUMENTS_BASEURL=
KNOWLEDGEBASE_SEARCH_BASEURL=
RETRIEVAL_TOPK=

# サービス間認証（s2s 認証 #76 完了までは既定 no-op 推奨。空=プレースホルダ）。
#   SERVICEAUTH_CLIENTID         サービス間認証クライアント ID
#   SERVICEAUTH_CLIENTSECRET     サービス間認証クライアントシークレット
SERVICEAUTH_CLIENTID=
SERVICEAUTH_CLIENTSECRET=