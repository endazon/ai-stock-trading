# =============================================================================
# ai-stock-trading ローカル実行環境 .env（テンプレート） — issue #107 / IADR-0048
# -----------------------------------------------------------------------------
# 使い方: このファイルを `.env` にコピーして値を編集する（`.env` は .gitignore 済み）。
#   cp .env.example .env
#   docker compose up
# 本ファイルには「キー名と用途コメント」のみを置く。**実値・実シークレットは書かない**。
# 機密（LLM/証券会社/Webhook 等）は空既定。有効化は明示設定時のみ（fail-safe）。
# 本番の資格情報は Vault/Secrets（ADR-0006 / #24）に委ね、本ファイルでは扱わない。
# =============================================================================

# --- PostgreSQL（dev ダミー。Database-per-Service: init が 7 専有 DB を作成する） ---
POSTGRES_USER=ai
POSTGRES_PASSWORD=ai

# --- RabbitMQ（dev ダミー。管理 UI: http://localhost:15672） ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- Keycloak（dev モード。管理コンソール: http://localhost:8081） ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# 実現するレルム名（realm-export.json と一致させる）。OwnerOnly 認可の検証は #82。
KEYCLOAK_REALM=ai-stock-trading

# --- 可観測性（OpenTelemetry Collector） ---
OTLP_ENDPOINT=http://otel-collector:4317

# =============================================================================
# fail-safe 有効化ポイント（既定は空＝各サービスは安全既定へ倒れる）
# 空のままなら: 実 LLM を呼ばない / 実市場データに接続しない / 実発注しない / 外部送信しない。
# =============================================================================

# 実 LLM エグレス（取引判断の実 LLM 連携）。空=呼ばない。実連携・費用計測は #79。
ANTHROPIC_API_KEY=

# 情報収集の実ソース。空=NoOp（外部接続しない）。案A+（ADR-0004）は複数ソースをカンマ区切りで指定する
# （例: finnhub,sec-edgar,edinet,boj,fred）。列挙しても当該ソースの必須設定が空なら、そのソースだけ無効になる
# （他のソースは有効なまま・IADR-0065）。銘柄・CIK・系列コードの一覧は 0 始まりの連番で指定する。
COLLECTION_SOURCE_PROVIDER=
# Finnhub Free（米国株の市況・60回/分）。
COLLECTION_FINNHUB_API_KEY=
COLLECTION_FINNHUB_SYMBOLS_0=
# SEC EDGAR（米国の開示・キー不要）。UserAgent は SEC 規約で必須の連絡先（空なら本ソースは無効）。
#   例: COLLECTION_SECEDGAR_USERAGENT="AiStockTrading/1.0 (owner@example.com)"
#   例: COLLECTION_SECEDGAR_CIKS_0=320193（Apple）
COLLECTION_SECEDGAR_USERAGENT=
COLLECTION_SECEDGAR_CIKS_0=
# EDINET API v2（日本の開示・要 API キー登録）。
COLLECTION_EDINET_SUBSCRIPTION_KEY=
# 日銀 時系列統計データ API（キー不要・クレジット表記必須）。DB は統計分類、SERIESCODES は系列コード。
#   例: COLLECTION_BOJ_DB=CO / COLLECTION_BOJ_SERIESCODES_0=TK99F1000601GCQ01000（短観 DI）
COLLECTION_BOJ_DB=
COLLECTION_BOJ_SERIESCODES_0=
# FRED（米マクロ・要 API キー・120回/分）。SERIESIDS は系列 ID（例: DGS10=米10年金利）。
COLLECTION_FRED_API_KEY=
COLLECTION_FRED_SERIESIDS_0=

# 通知の送信手段（例: discord-webhook）。空=NoOp（外部送信しない）。実送信は #15。
NOTIFICATIONS_PROVIDER=
NOTIFICATIONS_DISCORD_WEBHOOK_URL=

# 発注ブローカ。既定 paper（実発注しない・IADR-0016）。moomoo 実弾は #13/ADR-0002 PoC 後続。
BROKER_PROVIDER=paper
# moomoo（OpenD）資格情報。空=無効（実弾防止ゲート）。実接続は #13。
MOOMOO_API_KEY=
MOOMOO_API_SECRET=

# サービス間の同期照会 URL（s2s 認証 #76 完了までは既定 no-op 推奨。空=プレースホルダ）。
#   REPORTS_BASEURL           取引判断->報告書（GET /reports/daily-policy）
#   RISK_MANAGEMENT_BASEURL   取引判断/市場監視->リスク管理（GET /risk-controls/*）
#   COST_CONTROL_BASEURL      情報収集->費用統制（GET /costs/state）
REPORTS_BASEURL=
RISK_MANAGEMENT_BASEURL=
COST_CONTROL_BASEURL=

# サービス間認証（s2s 認証 #76 完了までは既定 no-op 推奨。空=プレースホルダ）。
#   SERVICEAUTH_CLIENTID         サービス間認証クライアント ID
#   SERVICEAUTH_CLIENTSECRET     サービス間認証クライアントシークレット
SERVICEAUTH_CLIENTID=
SERVICEAUTH_CLIENTSECRET=